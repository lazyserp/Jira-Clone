import json
import random

statuses = ["TODO", "IN_PROGRESS", "DONE"]

projects = []

for i in range(1, 101):
    project = {
        "name": f"Project {i}",
        "description": f"Description for Project {i}",
        "tasks": [
            {
                "title": f"Task {i}-{j}",
                "status": random.choice(statuses)
            }
            for j in range(1, 6)
        ]
    }
    projects.append(project)


import requests

for project in projects:
    requests.post(
        "http://localhost:8080/projects",
        json=project
    )